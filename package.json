{
  "name": "zed2cli",
  "version": "2.0.0",
  "description": "Use Zed-hosted AI models from opencode, pi, hermes, or any OpenAI compatible CLI through your Zed subscription, without running Zed.",
  "type": "module",
  "bin": {
    "zed2cli": "./cli.mjs"
  },
  "files": [
    "cli.mjs",
    "src/index.mjs",
    "src/index.v1.mjs",
    "src/models.mjs",
    "src/proxy.mjs",
    "src/package.json",
    "src/pi/zed-ai.mjs",
    "scripts/",
    "config/",
    "README.md",
    "INSTALL.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "zed",
    "zed-ai",
    "zed-editor",
    "opencode",
    "opencode-plugin",
    "pi",
    "hermes",
    "llm",
    "ai",
    "agent",
    "cli",
    "bridge",
    "proxy",
    "openai-compatible",
    "claude",
    "gpt",
    "gemini",
    "anthropic",
    "streaming"
  ],
  "license": "MIT",
  "author": "6yte96",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/6yte96/zed2cli.git"
  },
  "bugs": {
    "url": "https://github.com/6yte96/zed2cli/issues"
  },
  "homepage": "https://github.com/6yte96/zed2cli#readme",
  "os": [
    "linux",
    "darwin"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check-models": "node scripts/check-models.mjs",
    "prepublishOnly": "node --check cli.mjs && node --check src/index.mjs && node --check src/index.v1.mjs && node --check src/models.mjs && node --check src/proxy.mjs && node --check src/pi/zed-ai.mjs && node scripts/check-models.mjs && bash -n scripts/*.sh"
  }
}
