{
  "$schema": "https://opencode.ai/config.json",
  "$comment": "zed2cli OpenCode example. Run scripts/install-opencode.sh to copy the plugin and write this for you. OpenCode 2 uses \"plugins\" and points at the plugin directory. OpenCode 1 uses \"plugin\" and points at index.mjs inside it.",

  "plugins": [
    "/home/YOUR_USER/.config/opencode/node_modules/opencode-zed-ai"
  ],

  "provider": {
    "zed-ai-proxy": {
      "$comment": "Optional fallback: use the bridge proxy instead of the plugin (requires scripts/zed-proxy.sh running).",
      "npm": "@ai-sdk/openai-compatible",
      "name": "Zed AI (proxy)",
      "options": {
        "baseURL": "http://127.0.0.1:8787/v1",
        "apiKey": "zed-ai"
      },
      "models": {
        "claude-sonnet-4-6": { "name": "Claude Sonnet 4.6" },
        "claude-sonnet-5": { "name": "Claude Sonnet 5" },
        "gpt-5.5": { "name": "GPT-5.5" },
        "gpt-5-mini": { "name": "GPT-5 mini" },
        "gemini-3-flash": { "name": "Gemini 3 Flash" }
      }
    }
  },

  "model": "zed-ai/claude-sonnet-4-6"
}
